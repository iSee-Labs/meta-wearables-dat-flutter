  - com.meta.wearable:mwdat-core:1.0.0
  - com.meta.wearable:mwdat-camera:1.0.0
  - com.meta.wearable:mwdat-display:1.0.0
  - com.meta.wearable:mwdat-mockdevice:1.0.0
  - com.meta.wearable:mwdat-inputs:1.0.0   (experimental, optional)
